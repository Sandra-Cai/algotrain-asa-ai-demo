# ─────────────────────────────────────────────────────────────────────────
# CONVERT / CASH-OUT (Uniswap Trading API) — the prize-critical path
# ─────────────────────────────────────────────────────────────────────────
# 1. Get an API key at https://developers.uniswap.org (Quick Start) and read
#    which testnet + token addresses it supports.
VITE_UNISWAP_API_KEY=
# Optional override; defaults to the public gateway.
# VITE_UNISWAP_API=https://trade-api.gateway.uniswap.org/v1

# 2. Chain you'll demo on. 11155111 = Ethereum Sepolia testnet (default).
VITE_CHAIN_ID=11155111

# 3. The token the user CONVERTS FROM (the balance they earned). Must be a
#    real ERC-20 on VITE_CHAIN_ID that your wallet actually holds. On Sepolia
#    this is typically test USDC. Set the address + its decimals.
VITE_CONVERT_FROM_TOKEN=
VITE_CONVERT_FROM_DECIMALS=6

# 4. Tokens the user can CONVERT TO. Fill addresses for VITE_CHAIN_ID.
#    Leave one blank to hide it (the UI never offers a broken target).
#    ETH defaults to the zero address (native) and needs no override.
# VITE_TOKEN_ETH=0x0000000000000000000000000000000000000000
VITE_TOKEN_WBTC=
VITE_TOKEN_DAI=

# ─────────────────────────────────────────────────────────────────────────
# WALLET (Privy) — sign-in / embedded wallet. Stays as infra.
# ─────────────────────────────────────────────────────────────────────────
VITE_PRIVY_APP_ID=

# ─────────────────────────────────────────────────────────────────────────
# CASH OUT (1inch) — optional second prize leg. Fill when you wire it.
# ─────────────────────────────────────────────────────────────────────────
VITE_1INCH_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# LEGACY / disabled rails — left in repo as continuity history, env unset.
# (Arc, World, Hedera, Dynamic.) Do not set for the judged Uniswap submission.
# ─────────────────────────────────────────────────────────────────────────
# VITE_ARC_RPC_URL=
# VITE_ARC_CHAIN_ID=
# VITE_WORLD_APP_ID=
