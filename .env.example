# Algorand network (testnet recommended for demo)
VITE_ALGOD_NETWORK=testnet
VITE_ALGOD_SERVER=https://testnet-api.algonode.cloud
VITE_ALGOD_PORT=443
VITE_ALGOD_TOKEN=

# Reward: leave ASA empty to pay in ALGO (recommended for live pitch)
# VITE_REWARD_ASA_ID=123456789
# 10000 microAlgos = 0.01 ALGO (default demo payout)
VITE_REWARD_AMOUNT=10000
